# HORIZON configuration. Copy to .env and adjust. Every value is optional in development.
# In production (NODE_ENV=production) the server refuses to start with unsafe values.

# ---------------------------------------------------------------- Server
NODE_ENV=development
PORT=3000
HOST=127.0.0.1
# Public URL used in emails and links (no trailing slash)
APP_URL=http://localhost:3000
# Set when running behind a reverse proxy / load balancer (e.g. 1)
TRUST_PROXY=

# ---------------------------------------------------------------- Security
# Required in production: a random string of at least 32 characters.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# In development a secret is generated automatically in data/.dev-session-secret
SESSION_SECRET=
SESSION_MAX_AGE_HOURS=8

# ---------------------------------------------------------------- CAPTCHA (Cloudflare Turnstile)
# turnstile  = real widget, verified on the server via Cloudflare Siteverify (default)
# dev-bypass = offline development only: a checkbox whose fixed token is still checked on the server.
#              Refused when NODE_ENV=production.
CAPTCHA_PROVIDER=turnstile
# Leave empty in development to use Cloudflare's official test keys (always pass).
# Production requires your own keys from https://dash.cloudflare.com/?to=/:account/turnstile
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---------------------------------------------------------------- Email (optional)
# Without SMTP, emails (verification codes, grievance receipts) are printed to the server
# console and shown in the development mailbox on the verification page.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="HORIZON <no-reply@your-domain.example>"
# Development-only mailbox preview. Must be false in production.
DEV_MAILBOX=true

# ---------------------------------------------------------------- Storage
# SQLite database and private uploads (CVs, videos, proofs). Keep both out of public folders and back them up.
DATA_DIR=data
DATABASE_FILE=
STORAGE_DIR=storage
# auto (better-sqlite3 if installed, else Node's built-in node:sqlite) | better | node
SQLITE_DRIVER=auto

# ---------------------------------------------------------------- Uploads
MAX_CV_MB=5
MAX_PROOF_MB=5
MAX_VIDEO_MB=50
MAX_VIDEO_SECONDS=120

# ---------------------------------------------------------------- Grievance redressal
# Publish the real name and email of your Grievance Officer before launch.
GRIEVANCE_OFFICER_NAME="Grievance Officer (demo placeholder)"
GRIEVANCE_OFFICER_EMAIL=grievance@your-domain.example
GRIEVANCE_ACK_HOURS=24
GRIEVANCE_RESOLVE_DAYS=15
GRIEVANCE_URGENT_RESOLVE_HOURS=72
GRIEVANCE_APPEAL_DAYS=30
GRIEVANCE_REOPEN_DAYS=7
GRIEVANCE_RESPONDENT_DAYS=5
# Days within which verified recruiters commit to a first response
RECRUITER_RESPONSE_DAYS=14

# ---------------------------------------------------------------- Rate limits (per IP, per window)
RATE_LIMIT_DISABLED=false
LOGIN_RATE_LIMIT=10
REGISTER_RATE_LIMIT=8
API_RATE_LIMIT=600

# ---------------------------------------------------------------- Demo data (development only)
# Loads demo accounts and illustrative listings into an empty database on start.
# Must be false in production. Demo credentials can be overridden here.
SEED_ON_START=true
SEED_ADMIN_EMAIL=admin@horizon.example
SEED_ADMIN_PASSWORD=Horizon!Admin2026
SEED_STUDENT_EMAIL=riya.demo@iimidr.ac.in
SEED_STUDENT_PASSWORD=Horizon!Student2026
SEED_RECRUITER_EMAIL=talent@meridianarc.example
SEED_RECRUITER_PASSWORD=Horizon!Recruiter2026
SEED_PENDING_STUDENT_EMAIL=kabir.pending@example.org
SEED_PENDING_STUDENT_PASSWORD=Horizon!Pending2026
SEED_PENDING_RECRUITER_EMAIL=daniel@harbourline.example
SEED_PENDING_RECRUITER_PASSWORD=Horizon!Pending2026
