{
  "version": 2,
  "cleanUrls": true,
  "functions": {
    "api/index.js": {
      "includeFiles": "{public/**,server/**}"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/app/:match*",
      "destination": "/app"
    },
    {
      "source": "/recruiter/:match*",
      "destination": "/app"
    },
    {
      "source": "/admin/:match*",
      "destination": "/app"
    }
  ]
}
