{
  "version": 2,
  "cleanUrls": true,
  "functions": {
    "api/index.js": {
      "includeFiles": "{public/**,server/**}"
    }
  },
  "rewrites": [
    {
      "source": "/api/:match*",
      "destination": "/api/index.js"
    },
    {
      "source": "/app",
      "destination": "/app.html"
    },
    {
      "source": "/app/:match*",
      "destination": "/app.html"
    },
    {
      "source": "/recruiter",
      "destination": "/app.html"
    },
    {
      "source": "/recruiter/:match*",
      "destination": "/app.html"
    },
    {
      "source": "/admin",
      "destination": "/app.html"
    },
    {
      "source": "/admin/:match*",
      "destination": "/app.html"
    },
    {
      "source": "/grievance-redressal",
      "destination": "/grievance-redressal.html"
    }
  ]
}
